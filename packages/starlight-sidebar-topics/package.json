{
  "name": "starlight-sidebar-topics",
  "version": "0.8.0",
  "license": "MIT",
  "description": "Starlight plugin to split your documentation into different sections, each with its own sidebar.",
  "author": "HiDeoo <github@hideoo.dev> (https://hideoo.dev)",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./components/Sidebar.astro": "./src/components/starlight/Sidebar.astro",
    "./middleware": "./src/middleware.ts",
    "./overrides/Sidebar.astro": "./src/overrides/Sidebar.astro",
    "./schema": "./src/schema.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "test": "playwright install --with-deps chromium && playwright test",
    "test:ci": "playwright test",
    "lint": "eslint . --cache --max-warnings=0"
  },
  "dependencies": {
    "picomatch": "^4.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/picomatch": "^4.0.2"
  },
  "peerDependencies": {
    "@astrojs/starlight": ">=0.42.0",
    "astro": "^7.2.10"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./components/Sidebar.astro": "./dist/components/starlight/Sidebar.astro",
      "./middleware": {
        "types": "./dist/middleware.d.ts",
        "import": "./dist/middleware.js"
      },
      "./overrides/Sidebar.astro": "./dist/overrides/Sidebar.astro",
      "./schema": {
        "types": "./dist/schema.d.ts",
        "import": "./dist/schema.js"
      },
      "./package.json": "./package.json"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "keywords": [
    "starlight",
    "plugin",
    "sidebar",
    "topics",
    "sections",
    "documentation",
    "astro"
  ],
  "homepage": "https://github.com/HiDeoo/starlight-sidebar-topics",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HiDeoo/starlight-sidebar-topics.git",
    "directory": "packages/starlight-sidebar-topics"
  },
  "bugs": "https://github.com/HiDeoo/starlight-sidebar-topics/issues"
}
